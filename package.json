{
  "name": "trainer-68k",
  "version": "1.1.1",
  "description": "Application d'apprentissage de l'assembleur 68000",
  "main": "./out/main/index.js",
  "author": "Yannick Montfort",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "version:bump": "node scripts/bump-version.mjs",
    "dist:win": "npm run build:meta && electron-vite build && electron-builder --win",
    "dist:win:complet": "npm run build:meta && node scripts/preparer-emulateurs.mjs && electron-vite build && electron-builder --win --config electron-builder.complet.cjs",
    "emulateurs:preparer": "node scripts/preparer-emulateurs.mjs",
    "asm": "vite-node src/asm/cli/asm.ts --",
    "desasm": "vite-node src/asm/cli/desasm.ts --",
    "build:meta": "node scripts/build-meta.mjs",
    "dist:linux": "npm run build:meta && electron-vite build && electron-builder --linux",
    "dist:mac": "npm run build:meta && electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "monaco-editor": "^0.52.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.yannick.trainer68k",
    "productName": "68k Trainer",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "content",
        "to": "content"
      },
      {
        "from": "build-meta.json",
        "to": "build-meta.json"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "icon": "resources/icon.png",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "maintainer": "Yannick Montfort <yannickmontfort-rgb@users.noreply.github.com>",
      "synopsis": "Apprendre l'assembleur 68000 sur un Atari ST simulé",
      "artifactName": "68k-Trainer-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "minimumSystemVersion": "11.0",
      "artifactName": "68k-Trainer-${version}-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/yannickmontfort-rgb/68k-trainer"
}
